{
  "name": "bugtrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BUGTRACK — full-stack Chrome bug reporting system (MV3 extension + Express/MongoDB API + React dashboard)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "dashboard"
  ],
  "scripts": {
    "setup": "npm install",
    "mongo": "docker compose up -d",
    "mongo:stop": "docker compose down",
    "seed": "npm --prefix server run seed",
    "dev:server": "npm --prefix server run dev",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build:dashboard": "npm --prefix dashboard run build",
    "build": "npm run build:dashboard && node tools/stage-static.mjs",
    "start": "npm run build:dashboard && npm --prefix server run start",
    "test": "npm --prefix server test",
    "e2e": "node tools/e2e-live.mjs"
  }
}
