PORT=8787
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bugtrack
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads/screenshots
# Vercel Blob read/write token (optional). When set, screenshots are stored in
# Vercel Blob instead of the local filesystem (required for serverless deploys):
BLOB_READ_WRITE_TOKEN=
# Optional shared secret required from the extension for write endpoints:
BUGTRACK_API_KEY=
# GitHub issue export (optional): token + owner/repo
GITHUB_TOKEN=
GITHUB_REPO=yourname/yourrepo
# Request body limit for bug reports with embedded screenshots (in mb):
MAX_BODY_MB=20
